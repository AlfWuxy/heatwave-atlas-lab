{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "heatwave-atlas-lab",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "heatwave-atlas-lab.yilaoweather.org",
      "custom_domain": true
    }
  ]
}
